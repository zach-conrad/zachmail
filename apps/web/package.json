{
  "name": "@zachhub/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --dir src",
    "size": "size-limit",
    "perf:build": "VITE_DEMO=1 vite build --outDir dist-perf",
    "perf": "playwright test -c perf/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-router": "^1.170.44",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@size-limit/file": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zachhub/config": "workspace:*",
    "@zachhub/core": "workspace:*",
    "@zachhub/local-store": "workspace:*",
    "@zachhub/tokens": "workspace:*",
    "eslint-plugin-react-hooks": "^7.1.1",
    "size-limit": "^14.2.0",
    "vite": "^8.3.4"
  }
}
